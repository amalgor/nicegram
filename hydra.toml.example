# Hydra Node Configuration
# Copy this file to hydra.toml and customize as needed.
# All paths are relative to the directory where hydra-core is run.

# Network: SOCKS5 proxy and P2P settings
[network]
socks5_port = 1080
p2p_listen_port = 0  # 0 = random ephemeral port
bootstrap_nodes = ["/dns4/boot.ze1.org/tcp/33097"]
proxy_mode = "telegram"  # off | telegram | full

# AI model inference
[ai]
model_path = "models/qwen2.5-1.5b-instruct-q4_k_m.gguf"
max_generation_tokens = 128
cache_ttl_seconds = 300   # route decision cache TTL
cache_max_items = 1000    # route decision cache capacity

# Economic ledger and reputation
[econ]
db_path = "hydra_db"
settlement_threshold_bytes = 10000000  # 10 MB

# Telegram client (grammers MTProto)
# Obtain API credentials at https://my.telegram.org
[telegram]
api_id = 0           # your Telegram API ID (integer)
api_hash = ""        # your Telegram API hash (string)
session_path = "telegram.session"

# Content Intelligence: summarization, TLDR folding, attention tracking
[content]
db_path = "content.db"
summarization_max_tokens = 512
cache_ttl_seconds = 3600  # how long processed summaries are cached

# Transport definitions. Order matters for failover and routing preference.
[[transports]]
type = "wss"
endpoints = ["wss://relay.hydra-net.work", "wss://hydra-relay.hydra-net.workers.dev"]
mode = "telegram"           # telegram | all
device_id = ""              # auto-generated if empty

# Example VLESS transport. Keep commented out until you have a real URL.
# [[transports]]
# type = "vless"
# url = "vless://uuid@example.com:443?security=reality&type=tcp&sni=example.com&fp=chrome&pbk=PUBLIC_KEY&sid=SHORT_ID"
# mode = "all"              # telegram | all

# On-chain marketplace (Base Sepolia local wallet flow)
[crypto]
enabled = false
chain = "BASE-SEPOLIA"
rpc_url = "https://sepolia.base.org"
route_book_address = ""           # HydraRouteBook on Base Sepolia
identity_registry_address = "0x8004A818BFB912233c491871b3d84c89A494BD9e"
reputation_registry_address = "0x8004B663056A597Dffe9eCcC1965A193B7388713"  # optional for feedback/reputation
usdc_address = "0x036CbD53842c5426634e7929541eC2318f3dCF7e"

# Dynamic route discovery from the on-chain route book.
[discovery]
poll_interval_secs = 300
max_offers = 50
prefer_free = true
rpc_timeout_secs = 10

# Credit-first MVP policy for premium route access.
[credit]
trial_credit_usdc = 0.1
linked_credit_usdc = 1.0
growth_factor = 2.0
soft_nudge_threshold = 0.5
soft_throttle_threshold = 0.8
fallback_threshold = 1.0
min_speed_pct = 0.25
nudge_interval_secs = 3600
advanced_after_payments = 3

# Network intelligence pipeline: traffic classification and tracker blocking
[intelligence]
# Automatically block connections classified as trackers/ads (opt-in, default false).
# When false, connections are still classified — user sees verdicts in the UI
# before choosing to enable blocking.
auto_block_trackers = false
# Minimum confidence (0.0–1.0) required to auto-block a tracker connection
block_confidence_threshold = 0.8
# How long a cached classification verdict is reused (seconds, default 12h)
verdict_cache_ttl_seconds = 43200
# Maximum number of cached verdict entries
verdict_cache_max_entries = 50000

# Bootstrap node (only used with --bootstrap flag)
[bootstrap]
listen_port = 33097
