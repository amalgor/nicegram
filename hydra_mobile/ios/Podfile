platform :ios, '16.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('Flutter', 'Generated.xcconfig'), __dir__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. Run flutter pub get first."
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise 'FLUTTER_ROOT not found in Generated.xcconfig.'
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end

  dsym_script = '${SRCROOT}/scripts/embed_native_framework_dsyms.sh'
  dsym_phase_name = '[Hydra] Embed native framework dSYMs'

  # Plugin frameworks (objective_c, etc.) are arm64-only on the simulator.
  # Build Runner for arm64 too so dlopen/loadLibrary does not fail on Intel Macs.
  installer.aggregate_targets.each do |aggregate_target|
    project = aggregate_target.user_project
    project.native_targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['ARCHS[sdk=iphonesimulator*]'] = 'arm64'
      end

      next unless target.name == 'Runner'

      unless target.shell_script_build_phases.any? { |phase| phase.name == dsym_phase_name }
        phase = target.new_shell_script_build_phase(dsym_phase_name)
        phase.shell_script = "\"#{dsym_script}\"\n"
        phase.input_paths = []
        phase.output_paths = []
        thin = target.shell_script_build_phases.find { |p| p.name == 'Thin Binary' }
        if thin
          target.build_phases.move(phase, target.build_phases.index(thin))
        end
      end
    end
    project.save
  end
end
